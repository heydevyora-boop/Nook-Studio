# Base URL of the NOOKK STUDIO backend API (see server/.env.example).
# Must include the /api prefix.
#
# Local dev: point this at the backend dev server, as below.
# Deploying behind vercel.json's rewrites (or any setup where the frontend
# and backend share one origin): leave this UNSET. The client then falls
# back to a relative '/api', which Vercel rewrites to the "server" service.
VITE_API_URL=http://localhost:4000/api
#
# Netlify (production): set VITE_API_URL in Netlify's Environment variables to
# your deployed backend, e.g. https://your-api.onrender.com/api, then redeploy.
# Leaving it unset on Netlify makes the form call nookkstudio.com/api -> 404.
