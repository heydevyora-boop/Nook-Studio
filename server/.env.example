# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed origins for CORS
CORS_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL via Prisma) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nookk_studio?schema=public"

# --- Auth (JWT) ---
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# --- Cloudinary (image uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email ---
# Preferred: Resend. Leave RESEND_API_KEY unset to fall back to SMTP/Nodemailer.
RESEND_API_KEY=
# Fallback SMTP (Nodemailer) — only used when RESEND_API_KEY is not set
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

MAIL_FROM="NOOKK STUDIO <Studionookk@gmail.com>"
STUDIO_NOTIFICATION_EMAIL=Studionookk@gmail.com

# --- Google Sheets inquiry mirror (optional) ---
# Every consultation-form submission is appended as a row to a Google Sheet.
# Leave these blank to disable (inquiries are then saved to PostgreSQL only).
# Setup guide: server/README.md -> "Google Sheets integration".
# ONLY ever set these on the BACKEND host (Render/Railway/...) — never in
# Netlify, never as VITE_* variables, never committed to git.
#
# The ID is the long token in the sheet's URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
# The worksheet (tab) name shown at the bottom of the sheet. Defaults to Sheet1.
GOOGLE_SHEETS_SHEET_NAME=Sheet1
# "client_email" from the service-account JSON key
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# "private_key" from the JSON key. Paste it exactly as-is (with real newlines),
# or as ONE line with literal \n between lines, optionally wrapped in quotes:
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=

# --- Rate limiting ---
INQUIRY_RATE_LIMIT_WINDOW_MINUTES=60
INQUIRY_RATE_LIMIT_MAX=5
