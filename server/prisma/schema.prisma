generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev and Docker/Render/Railway; "rhel-openssl-3.0.x"
  // is the engine Prisma's own docs recommend for Vercel's Node.js Functions
  // runtime, which differs from this build machine's own platform.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  STAFF
  USER
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum ProjectCategory {
  INTERIOR_DESIGN
  PRODUCT_DESIGN
  SPACE_PLANNING
  DESIGN_CONSULTATION
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

// Tracks whether an inquiry has been mirrored to the Google Sheet.
//   PENDING -> not yet written (or waiting for its next retry)
//   SYNCED  -> row confirmed present in the sheet
//   FAILED  -> gave up after too many attempts; re-queued on next server boot
enum SheetsSyncStatus {
  PENDING
  SYNCED
  FAILED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journalPosts JournalPost[]

  @@map("users")
}

model Project {
  id               String          @id @default(cuid())
  title            String
  slug             String          @unique
  location         String?
  category         ProjectCategory
  description      String          @db.Text
  shortDescription String?
  coverImage       String
  images           String[]        @default([])
  featured         Boolean         @default(false)
  status           ContentStatus   @default(DRAFT)
  year             Int?
  client           String?
  deletedAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status, featured])
  @@index([category])
  @@index([deletedAt])
  @@map("projects")
}

model Service {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String    @db.Text
  icon        String
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, order])
  @@index([deletedAt])
  @@map("services")
}

model JournalPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String    @db.Text
  excerpt     String?
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
  @@index([deletedAt])
  @@map("journal_posts")
}

model Inquiry {
  id          String        @id @default(cuid())
  name        String
  email       String
  phone       String?
  projectType String?
  budgetRange String?
  areaSqFt    Int?
  message     String        @db.Text
  status      InquiryStatus @default(NEW)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Duplicate-submission guard: hash of the submitted fields + a 10-minute
  // time bucket. Unique, so a double-click / network retry can't create a
  // second row. Null for inquiries created before this column existed.
  submissionKey String? @unique

  // Google Sheets mirror (PostgreSQL stays the source of truth).
  sheetsSyncStatus    SheetsSyncStatus @default(PENDING)
  sheetsSyncAttempts  Int              @default(0)
  // Next time a retry is allowed. Also used as a short lease while an attempt is in flight.
  sheetsNextAttemptAt DateTime?
  sheetsSyncedAt      DateTime?
  sheetsLastError     String?

  @@index([status, createdAt])
  @@index([sheetsSyncStatus, sheetsNextAttemptAt])
  @@map("inquiries")
}

model Testimonial {
  id           String    @id @default(cuid())
  clientName   String
  projectTitle String?
  content      String    @db.Text
  rating       Int       @default(5)
  image        String?
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive])
  @@index([deletedAt])
  @@map("testimonials")
}
